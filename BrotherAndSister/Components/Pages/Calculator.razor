</style>

@code {
    private List<Question> questions = new();
    private int CurrentQuestionIndex = 0;
    private Dictionary<Question, List<ServiceOption>> selectedOptions = new();
    private bool showResults = false;

    protected override void OnInitialized()
    {
        InitializeQuestions();
        InitializeSelections();
    }

    private void InitializeQuestions()
    {
        questions = new List<Question>
        {
            new Question
            {
                Id = 1,
                Title = "Какие услуги вам нужны?",
                Description = "Выберите услуги, которые вас интересуют",
                Icon = "🎬",
                AllowMultiple = true, // Разрешаем множественный выбор
                Options = new List<ServiceOption>
                {
                    new ServiceOption { Name = "Видеомонтаж", Price = 5000, Icon = "✂️", Description = "Профессиональный монтаж видео любой сложности" },
                    new ServiceOption { Name = "Озвучка", Price = 3000, Icon = "🎙️", Description = "Профессиональная озвучка голосом" },
                    new ServiceOption { Name = "Анимация", Price = 8000, Icon = "🎨", Description = "2D/3D анимация, motion design" },
                    new ServiceOption { Name = "Сценарий", Price = 4000, Icon = "📝", Description = "Написание сценария для видео" },
                }
            },
            new Question
            {
                Id = 2,
                Title = "Срок выполнения",
                Description = "Укажите желаемые сроки выполнения проекта",
                Icon = "⏱️",
                AllowMultiple = false, // Только один выбор
                Options = new List<ServiceOption>
                {
                    new ServiceOption { Name = "Срочно (1-2 дня)", Price = 5000, Icon = "🔥", Description = "Ускоренная обработка +50% к стоимости" },
                    new ServiceOption { Name = "Стандартно (3-5 дней)", Price = 0, Icon = "📅", Description = "Стандартный срок выполнения" },
                    new ServiceOption { Name = "Обычно (5-7 дней)", Price = -1000, Icon = "🐢", Description = "Скидка за спокойный режим" }
                }
            },
            new Question
            {
                Id = 3,
                Title = "Сложность проекта",
                Description = "Оцените сложность вашего проекта",
                Icon = "⚙️",
                AllowMultiple = false, // Только один выбор
                Options = new List<ServiceOption>
                {
                    new ServiceOption { Name = "Простой", Price = 0, Icon = "😊", Description = "Базовая обработка, минимум правок" },
                    new ServiceOption { Name = "Средний", Price = 3000, Icon = "👍", Description = "Стандартные требования к качеству" },
                    new ServiceOption { Name = "Сложный", Price = 7000, Icon = "🎯", Description = "Высокие требования, много деталей" },
                    new ServiceOption { Name = "Премиум", Price = 12000, Icon = "💎", Description = "Максимальное качество, много правок" }
                }
            },
            new Question
            {
                Id = 4,
                Title = "Дополнительные услуги",
                Description = "Выберите дополнительные опции (можно несколько)",
                Icon = "✨",
                AllowMultiple = true, // Разрешаем множественный выбор
                Options = new List<ServiceOption>
                {
                    new ServiceOption { Name = "Цветокоррекция", Price = 2000, Icon = "🎨", Description = "Профессиональная цветокоррекция" },
                    new ServiceOption { Name = "Звуковой дизайн", Price = 2500, Icon = "🔊", Description = "Создание звукового сопровождения" },
                    new ServiceOption { Name = "Субтитры", Price = 1500, Icon = "📝", Description = "Добавление субтитров" },
                    new ServiceOption { Name = "Перевод", Price = 3000, Icon = "🌍", Description = "Перевод на другие языки" }
                }
            }
        };
    }

    private void InitializeSelections()
    {
        foreach (var question in questions)
        {
            selectedOptions[question] = new List<ServiceOption>();
        }
    }

    private Question? CurrentQuestion => CurrentQuestionIndex < questions.Count ? questions[CurrentQuestionIndex] : null;

    private int CurrentProgress => (CurrentQuestionIndex + 1) * 100 / questions.Count;

    private bool IsOptionSelected(ServiceOption option)
    {
        if (CurrentQuestion == null) return false;
        
        var currentSelections = selectedOptions[CurrentQuestion];
        return currentSelections.Contains(option);
    }

    private void SelectOption(ServiceOption option)
    {
        if (CurrentQuestion == null) return;
        
        var currentSelections = selectedOptions[CurrentQuestion];
        
        if (CurrentQuestion.AllowMultiple)
        {
            // Множественный выбор: добавляем или удаляем опцию
            if (currentSelections.Contains(option))
            {
                currentSelections.Remove(option);
            }
            else
            {
                currentSelections.Add(option);
            }
        }
        else
        {
            // Одиночный выбор: очищаем и добавляем новую опцию
            currentSelections.Clear();
            currentSelections.Add(option);
        }
        
        // Принудительно обновляем UI
        StateHasChanged();
    }

    private void NextQuestion()
    {
        if (CurrentQuestionIndex < questions.Count - 1)
        {
            CurrentQuestionIndex++;
        }
        else
        {
            CalculateTotal();
        }
    }

    private void PreviousQuestion()
    {
        if (CurrentQuestionIndex > 0)
        {
            CurrentQuestionIndex--;
        }
    }

    private int TotalPrice
    {
        get
        {
            int total = 0;
            foreach (var selection in selectedOptions)
            {
                foreach (var option in selection.Value)
                {
                    total += option.Price;
                }
            }
            return total > 0 ? total : 0;
        }
    }

    private List<QuestionSelection> allSelectedOptions
    {
        get
        {
            var result = new List<QuestionSelection>();
            foreach (var selection in selectedOptions)
            {
                if (selection.Value.Any())
                {
                    result.Add(new QuestionSelection
                    {
                        QuestionTitle = selection.Key.Title,
                        SelectedOptions = selection.Value.ToList()
                    });
                }
            }
            return result;
        }
    }

    private void CalculateTotal()
    {
        showResults = true;
    }

    private void CloseResults()
    {
        showResults = false;
    }

    private void ResetCalculator()
    {
        InitializeSelections();
        CurrentQuestionIndex = 0;
        showResults = false;
        StateHasChanged();
    }

    private string FormatPrice(int price)
    {
        if (price == 0) return "Включено";
        if (price < 0) return $"-{Math.Abs(price):N0} ₽";
        return $"{price:N0} ₽";
    }

    private class Question
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public bool AllowMultiple { get; set; } = false;
        public List<ServiceOption> Options { get; set; } = new();
    }

    private class ServiceOption
    {
        public string Name { get; set; } = string.Empty;
        public int Price { get; set; }
        public string Icon { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    private class QuestionSelection
    {
        public string QuestionTitle { get; set; } = string.Empty;
        public List<ServiceOption> SelectedOptions { get; set; } = new();
    }
}