                    new SubService { Name = "Сведение аудиотреков", Price = 2000, EstimatedDays = 3 }
                }
            },
            new Service
            {
                Name = "Сценарии",
                SubServices = new List<SubService>
                {
                    new SubService { Name = "Сценарий для видео (до 5 мин)", Price = 2000, EstimatedDays = 3 },
                    new SubService { Name = "Сценарий для видео (5-15 мин)", Price = 3500, EstimatedDays = 5 },
                    new SubService { Name = "Сценарий для фильма", Price = 5000, EstimatedDays = 7 },
                    new SubService { Name = "Адаптация сценария", Price = 1500, EstimatedDays = 2 }
                }
            }
        };
    }

    private string GetServiceIcon(string serviceName)
    {
        return serviceName switch
        {
            "Монтаж видео" => "🎬",
            "Анимация" => "🎨",
            "Озвучка" => "🎙️",
            "Сценарии" => "📝",
            _ => "✨"
        };
    }

    private string FormatPrice(decimal price)
    {
        return $"{price:N0} ₽";
    }

    private void ToggleService(Service service)
    {
        service.IsExpanded = !service.IsExpanded;
    }

    private void NextSlide()
    {
        if (currentSlide < exampleWorks.Count - 1)
        {
            currentSlide++;
        }
    }

    private void PrevSlide()
    {
        if (currentSlide > 0)
        {
            currentSlide--;
        }
    }

    private void GoToSlide(int index)
    {
        currentSlide = index;
    }

    private class SubService
    {
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int EstimatedDays { get; set; }
    }

    private class Service
    {
        public string Name { get; set; } = string.Empty;
        public List<SubService> SubServices { get; set; } = new();
        public bool IsExpanded { get; set; } = false;
    }

    private class ExampleWork
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public List<string> Tags { get; set; } = new();
    }
}