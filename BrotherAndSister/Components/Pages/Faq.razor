@page "/faq"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="faq-container">
    <!-- Hero секция -->
    <div class="faq-hero">
        <div class="hero-content">
            <h1 class="hero-title">Часто задаваемые <span class="gradient-text">вопросы</span></h1>
            <p class="hero-description">Ответы на самые популярные вопросы о нашей работе и сотрудничестве</p>
        </div>
    </div>

    <div class="faq-content">
        <!-- Кнопка добавления вопроса (только для админа) -->
        @if (isAdmin)
        {
            <div class="admin-actions">
                <button class="btn-add-question" @onclick="OpenAddModal">
                    <span class="btn-icon">➕</span>
                    Добавить вопрос
                </button>
            </div>
        }

        <!-- Список вопросов -->
        <div class="faq-list">
            @foreach (var item in faqs.OrderBy(f => f.Order))
            {
                <div class="faq-item">
                    <div class="faq-question @(item.IsExpanded ? "expanded" : "")" @onclick="() => ToggleAnswer(item)">
                        <div class="question-content">
                            <span class="question-icon">❓</span>
                            <span class="question-text">@item.Question</span>
                        </div>
                        <div class="question-actions">
                            @if (isAdmin)
                            {
                                <button class="action-btn edit-btn" @onclick:stopPropagation="true" @onclick="() => OpenEditModal(item)">
                                    ✎
                                </button>
                                <button class="action-btn delete-btn" @onclick:stopPropagation="true" @onclick="() => DeleteQuestion(item)">
                                    ✕
                                </button>
                            }
                            <span class="toggle-icon">@(item.IsExpanded ? "▲" : "▼")</span>
                        </div>
                    </div>
                    <div class="answer-wrapper @(item.IsExpanded ? "show" : "")">
                        <div class="answer-content">
                            <div class="answer-icon">💬</div>
                            <div class="answer-text">@item.Answer</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Пустое состояние -->
        @if (!faqs.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <h3>Пока нет вопросов</h3>
                <p>Будьте первым, кто задаст вопрос!</p>
            </div>
        }
    </div>

    <!-- Модальное окно добавления/редактирования -->
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>@(editingItem == null ? "➕ Добавить вопрос" : "✎ Редактировать вопрос")</h3>
                    <button class="modal-close" @onclick="CloseModal">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Вопрос:</label>
                        <input type="text" @bind="editQuestion" class="form-input" placeholder="Введите вопрос..." />
                    </div>
                    <div class="form-group">
                        <label>Ответ:</label>
                        <textarea @bind="editAnswer" class="form-textarea" rows="5" placeholder="Введите ответ..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CloseModal">Отмена</button>
                    <button class="btn-save" @onclick="SaveQuestion">Сохранить</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .faq-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Hero секция */
    .faq-hero {
        background: rgba(0, 0, 0, 0.3);
        padding: 100px 20px 60px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .hero-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 3rem;
        color: white;
        margin-bottom: 20px;
        font-weight: 700;
        animation: fadeInDown 0.8s ease;
    }

    .gradient-text {
        background: linear-gradient(45deg, #FFD700, #FF69B4);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-description {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.9);
        animation: fadeInUp 0.8s ease;
    }

    /* Основной контент */
    .faq-content {
        max-width: 900px;
        margin: -40px auto 0;
        padding: 0 20px 60px;
        position: relative;
        z-index: 1;
    }

    /* Админ панель */
    .admin-actions {
        text-align: right;
        margin-bottom: 30px;
    }

    .btn-add-question {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 30px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .btn-add-question:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    /* Список вопросов */
    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .faq-item {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .faq-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
    }

    .faq-question {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 25px;
        cursor: pointer;
        background: white;
        transition: all 0.3s ease;
    }

    .faq-question.expanded {
        background: linear-gradient(135deg, #f8f9fa, #ffffff);
        border-bottom: 1px solid #f0f0f0;
    }

    .question-content {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .question-icon {
        font-size: 1.3rem;
    }

    .question-text {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
    }

    .question-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .edit-btn {
        background: #667eea;
        color: white;
    }

    .edit-btn:hover {
        background: #5a67d8;
        transform: scale(1.1);
    }

    .delete-btn {
        background: #e74c3c;
        color: white;
    }

    .delete-btn:hover {
        background: #c0392b;
        transform: scale(1.1);
    }

    .toggle-icon {
        font-size: 1rem;
        color: #667eea;
        margin-left: 10px;
        transition: transform 0.3s ease;
    }

    /* Блок ответа */
    .answer-wrapper {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s ease;
        background: #f8f9fa;
    }

    .answer-wrapper.show {
        max-height: 500px;
    }

    .answer-content {
        display: flex;
        gap: 15px;
        padding: 20px 25px;
        border-top: 1px solid #f0f0f0;
        animation: fadeInUp 0.3s ease;
    }

    .answer-icon {
        font-size: 1.2rem;
        min-width: 30px;
    }

    .answer-text {
        font-size: 1rem;
        line-height: 1.6;
        color: #555;
        flex: 1;
    }

    /* Модальное окно */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
        animation: fadeIn 0.3s ease;
    }

    .modal-content {
        background: white;
        border-radius: 30px;
        max-width: 600px;
        width: 100%;
        animation: slideUp 0.3s ease;
        overflow: hidden;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 30px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.3rem;
    }

    .modal-close {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }

    .modal-close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
    }

    .modal-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .form-input, .form-textarea {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-input:focus, .form-textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        padding: 20px 30px;
        background: #f8f9fa;
    }

    .btn-cancel, .btn-save {
        padding: 10px 25px;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-cancel {
        background: #e74c3c;
        color: white;
    }

    .btn-cancel:hover {
        background: #c0392b;
        transform: translateY(-2px);
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    /* Пустое состояние */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 30px;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 1.3rem;
        color: #333;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #666;
    }

    /* Анимации */
    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .faq-question {
            padding: 15px 20px;
        }

        .question-text {
            font-size: 1rem;
        }

        .question-content {
            flex-wrap: wrap;
        }

        .answer-content {
            flex-direction: column;
            gap: 10px;
        }

        .modal-content {
            margin: 0 15px;
        }
    }
</style>

@code {
    private List<FaqItem> faqs = new();
    private bool isAdmin = true; // В реальном проекте проверяйте авторизацию
    private bool showModal = false;
    private FaqItem? editingItem = null;
    private string editQuestion = "";
    private string editAnswer = "";
    private int nextId = 4;

    protected override void OnInitialized()
    {
        LoadFaqs();
    }

    private void LoadFaqs()
    {
        faqs = new List<FaqItem>
        {
            new FaqItem
            {
                Id = 1,
                Question = "Как происходит оплата?",
                Answer = "Мы принимаем оплату несколькими способами: банковский перевод на карту Сбербанка, перевод на расчетный счет для юридических лиц, а также через платежные системы (ЮMoney, Stripe). Предоплата составляет 50% от суммы проекта, остальные 50% после завершения работы и утверждения результата.",
                Order = 1,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 2,
                Question = "Какие сроки выполнения работ?",
                Answer = "Сроки зависят от сложности проекта. В среднем: видеомонтаж — 3-7 дней, озвучка — 1-3 дня, анимация — 5-14 дней, написание сценария — 2-5 дней. Мы всегда согласовываем точные сроки до начала работы и соблюдаем дедлайны.",
                Order = 2,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 3,
                Question = "Предоставляете ли вы правки?",
                Answer = "Да! Мы предоставляем 2-3 бесплатных цикла правок в зависимости от сложности проекта. После завершения работы мы показываем результат и вносим необходимые корректировки до полного вашего удовлетворения. Дополнительные правки обсуждаются отдельно.",
                Order = 3,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 4,
                Question = "Какие форматы файлов вы принимаете?",
                Answer = "Мы работаем с любыми популярными форматами: видео — MP4, MOV, AVI, MKV; аудио — MP3, WAV, AIFF; изображения — JPG, PNG, PSD, AI; документы — DOCX, PDF, TXT. Если у вас специфический формат — свяжитесь с нами, мы найдем решение.",
                Order = 4,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 5,
                Question = "Работаете ли вы с юридическими лицами?",
                Answer = "Да, мы работаем как с физическими, так и с юридическими лицами. Предоставляем все необходимые документы: договор, акт выполненных работ, счет на оплату. Работаем по безналичному расчету с НДС и без.",
                Order = 5,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 6,
                Question = "Как происходит передача готового проекта?",
                Answer = "Готовый проект мы отправляем через облачное хранилище (Google Drive, Яндекс.Диск, Dropbox) или любым удобным для вас способом. Также можем предоставить ссылку для скачивания с паролем для защиты контента.",
                Order = 6,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 7,
                Question = "Сохраняете ли вы исходные файлы?",
                Answer = "Да, мы храним все исходные файлы проекта в течение 3 месяцев после сдачи работы. Если вам понадобятся исходники позже — мы всегда можем их предоставить.",
                Order = 7,
                IsExpanded = false
            },
            new FaqItem
            {
                Id = 8,
                Question = "Какие гарантии вы предоставляете?",
                Answer = "Мы гарантируем качественное выполнение работы в оговоренные сроки. В случае возникновения проблем (технические ошибки, потеря файлов) — исправляем за свой счет. Также мы подписываем договор, который защищает интересы обеих сторон.",
                Order = 8,
                IsExpanded = false
            }
        };
        
        nextId = faqs.Max(f => f.Id) + 1;
    }

    private void ToggleAnswer(FaqItem item)
    {
        item.IsExpanded = !item.IsExpanded;
        StateHasChanged();
    }

    private void OpenAddModal()
    {
        editingItem = null;
        editQuestion = "";
        editAnswer = "";
        showModal = true;
        StateHasChanged();
    }

    private void OpenEditModal(FaqItem item)
    {
        editingItem = item;
        editQuestion = item.Question;
        editAnswer = item.Answer;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        editingItem = null;
        editQuestion = "";
        editAnswer = "";
        StateHasChanged();
    }

    private void SaveQuestion()
    {
        if (string.IsNullOrWhiteSpace(editQuestion) || string.IsNullOrWhiteSpace(editAnswer))
            return;

        if (editingItem != null)
        {
            // Редактирование существующего вопроса
            editingItem.Question = editQuestion;
            editingItem.Answer = editAnswer;
        }
        else
        {
            // Добавление нового вопроса
            faqs.Add(new FaqItem
            {
                Id = nextId++,
                Question = editQuestion,
                Answer = editAnswer,
                Order = faqs.Max(f => f.Order) + 1,
                IsExpanded = false
            });
        }

        CloseModal();
        StateHasChanged();
    }

    private async Task DeleteQuestion(FaqItem item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить вопрос: \"{item.Question}\"?");
        if (confirmed)
        {
            faqs.Remove(item);
            StateHasChanged();
        }
    }

    private class FaqItem
    {
        public int Id { get; set; }
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
        public int Order { get; set; }
        public bool IsExpanded { get; set; }
    }
}