            ImageUrl = "https://via.placeholder.com/800x450/667eea/ffffff?text=Corporate+Video",
            Tags = new List<string> { "Видеомонтаж", "Озвучка", "Цветокоррекция" }
        },
        new ExampleWork
        {
            Title = "Анимационный трейлер",
            Description = "2D анимация для мобильной игры",
            ImageUrl = "https://via.placeholder.com/800x450/764ba2/ffffff?text=Animation+Trailer",
            Tags = new List<string> { "Анимация", "Моушн-дизайн", "Звуковой дизайн" }
        },
        new ExampleWork
        {
            Title = "Рекламный ролик",
            Description = "Креативная реклама для бренда одежды",
            ImageUrl = "https://via.placeholder.com/800x450/ff69b4/ffffff?text=Ad+Video",
            Tags = new List<string> { "Сценарий", "Монтаж", "Постпродакшн" }
        },
        new ExampleWork
        {
            Title = "Документальный фильм",
            Description = "Полный цикл производства документального кино",
