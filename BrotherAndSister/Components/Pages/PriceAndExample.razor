                {
                    new SubService { Name = "Базовый монтаж (нарезка, склейка)", Price = 1000, EstimatedDays = 4 },
                    new SubService { Name = "Продвинутый монтаж + эффекты", Price = 2000, EstimatedDays = 7 },
                    new SubService { Name = "Премиум монтаж + цветокоррекция", Price = 3500, EstimatedDays = 10 },
                    new SubService { Name = "Полный цикл производства", Price = 5000, EstimatedDays = 14 }
                }
            },
            new Service
            {
                Name = "Анимация",
                SubServices = new List<SubService>
                {
                    new SubService { Name = "Базовая 2D анимация", Price = 3000, EstimatedDays = 5 },
                    new SubService { Name = "Сложная 2D анимация", Price = 5000, EstimatedDays = 8 },
                    new SubService { Name = "3D анимация", Price = 8000, EstimatedDays = 12 },
                    new SubService { Name = "Моушн-дизайн", Price = 4000, EstimatedDays = 6 }
                }
            },
            new Service
            {
                Name = "Озвучка",
                SubServices = new List<SubService>
                {
                    new SubService { Name = "Дикторская озвучка", Price = 1500, EstimatedDays = 2 },
                    new SubService { Name = "Актерская озвучка", Price = 2500, EstimatedDays = 3 },
