@page "/calculator"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="calculator-container">
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Калькулятор <span class="gradient-text">медиа-проекта</span></h1>
            <p class="hero-description">Ответьте на несколько вопросов, и мы рассчитаем стоимость вашего проекта</p>
        </div>
    </div>

    <div class="calculator-main">
        <div class="progress-section">
            <div class="progress-bar-container">
                <div class="progress-bar" style="width: @(CurrentProgress)%"></div>
            </div>
            <div class="progress-steps">
                <span>Шаг @(CurrentQuestionIndex + 1) из @questions.Count</span>
                <span class="progress-percent">@CurrentProgress%</span>
            </div>
        </div>

        @if (CurrentQuestion != null)
        {
            <div class="question-card">
                <div class="question-header">
                    <div class="question-icon">@CurrentQuestion.Icon</div>
                    <h2 class="question-title">@CurrentQuestion.Title</h2>
                </div>
                <p class="question-description">@CurrentQuestion.Description</p>
                
                @if (CurrentQuestion.AllowMultiple)
                {
                    <div class="multiple-hint">✓ Можно выбрать несколько вариантов</div>
                }

                <div class="options-container">
                    @foreach (var option in CurrentQuestion.Options)
                    {
                        <div class="option-item @(IsOptionSelected(option) ? "selected" : "")"
                             @onclick="() => SelectOption(option)">
                            <div class="option-content">
                                <div class="option-icon">@option.Icon</div>
                                <div class="option-info">
                                    <div class="option-name">@option.Name</div>
                                    <div class="option-price">@FormatPrice(option.Price)</div>
                                    <div class="option-description">@option.Description</div>
                                </div>
                                <div class="option-check">
                                    @if (IsOptionSelected(option))
                                    {
                                        <span class="check-mark">✓</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="navigation-buttons">
            <button class="nav-btn prev-btn" @onclick="PreviousQuestion" disabled="@(CurrentQuestionIndex == 0)">
                ← Назад
            </button>
            <button class="nav-btn next-btn" @onclick="NextQuestion">
                @if (CurrentQuestionIndex == questions.Count - 1)
                {
                    <span>Рассчитать →</span>
                }
                else
                {
                    <span>Далее →</span>
                }
            </button>
        </div>
    </div>

    @if (showResults)
    {
        <div class="results-overlay">
            <div class="results-card">
                <div class="results-header">
                    <h2 class="results-title">Расчет стоимости</h2>
                    <div class="close-btn" @onclick="CloseResults">✕</div>
                </div>

                <div class="total-price-section">
                    <div class="total-label">Итого стоимость проекта</div>
                    <div class="total-price">@FormatPrice(TotalPrice)</div>
                    <div class="total-note">*Окончательная стоимость может отличаться после консультации</div>
                </div>

                <div class="details-section">
                    <h3>Выбранные услуги:</h3>
                    <div class="services-list">
                        @foreach (var selection in allSelectedOptions)
                        {
                            <div class="service-item">
                                <span class="service-category">@selection.QuestionTitle:</span>
                                <div class="service-options">
                                    @foreach (var option in selection.SelectedOptions)
                                    {
                                        <div class="service-option-item">
                                            <span class="service-name">@option.Name</span>
                                            <span class="service-price">@FormatPrice(option.Price)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="contact-section">
                    <p class="contact-text">Готовы начать проект?</p>
                    <div class="contact-buttons">
                        <a href="/About#contacts" class="contact-btn primary">Связаться с нами</a>
                        <button class="contact-btn secondary" @onclick="ResetCalculator">Новый расчет</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
