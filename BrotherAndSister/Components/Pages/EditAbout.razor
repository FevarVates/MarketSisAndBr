@page "/editAbout"
@rendermode InteractiveServer

<h2>О нас</h2>

<div class="about-section">
    <!-- Общий рассказ -->
    <div class="section">
        <h3>Описание проекта</h3>
        @if (isEditing)
        {
            <textarea @bind="projectDescription" class="text-area"></textarea>
            <div class="buttons">
                <button class="btn save" @onclick="SaveProjectDescription">Сохранить</button>
                <button class="btn cancel" @onclick="CancelEdit">Отменить</button>
            </div>
        }
        else
        {
            <p>@projectDescription</p>
            <button class="btn edit" @onclick="EnableEdit">Редактировать</button>
        }
    </div>

    <!-- Отзывы от брата -->
    <div class="section">
        <h3>От брата</h3>
        @if (isBrotherEditing)
        {
            <textarea @bind="brotherDescription" class="text-area"></textarea>
            <div class="buttons">
                <button class="btn save" @onclick="SaveBrotherDescription">Сохранить</button>
                <button class="btn cancel" @onclick="CancelBrotherEdit">Отменить</button>
            </div>
        }
        else
        {
            <p>@brotherDescription</p>
            <button class="btn edit" @onclick="EnableBrotherEdit">Редактировать</button>
        }
    </div>

    <!-- Отзывы от сестры -->
    <div class="section">
        <h3>От сестры</h3>
        @if (isSisterEditing)
        {
            <textarea @bind="sisterDescription" class="text-area"></textarea>
            <div class="buttons">
                <button class="btn save" @onclick="SaveSisterDescription">Сохранить</button>
                <button class="btn cancel" @onclick="CancelSisterEdit">Отменить</button>
            </div>
        }
        else
        {
            <p>@sisterDescription</p>
            <button class="btn edit" @onclick="EnableSisterEdit">Редактировать</button>
        }
    </div>
</div>

@code {
    // Основной текст о проекте
    private string projectDescription = "Это команда профессионалов, которая занимается видео с нуля на заказ: пишем сценарий, делаем звук лучше, анимируем, делаем видеоряд.";
    private bool isEditing = false;

    // Описание от брата
    private string brotherDescription = "Я брат, и я очень горжусь своей сестрой. Вместе мы создаем потрясающее видео и делаем это с любовью.";
    private bool isBrotherEditing = false;

    // Описание от сестры
    private string sisterDescription = "Я сестра, я творческий человек, и мне нравится превращать идеи в живое видео. Работать с братом — настоящее удовольствие.";
    private bool isSisterEditing = false;

    // Методы для редактирования общего текста
    private void EnableEdit() { isEditing = true; }
    private void SaveProjectDescription()
    {
        // Можно сюда добавить сохранение в базу или API
        isEditing = false;
    }
    private void CancelEdit()
    {
        // В случае отмены можно вернуть начальный текст или просто закрыть
        isEditing = false;
    }

    // Методы для описания брата
    private void EnableBrotherEdit() { isBrotherEditing = true; }
    private void SaveBrotherDescription()
    {
        isBrotherEditing = false;
    }
    private void CancelBrotherEdit()
    {
        isBrotherEditing = false;
    }

    // Методы для описания сестры
    private void EnableSisterEdit() { isSisterEditing = true; }
    private void SaveSisterDescription()
    {
        isSisterEditing = false;
    }
    private void CancelSisterEdit()
    {
        isSisterEditing = false;
    }
}
<style>
    /* Стиль страницы */
    .about-section {
        max-width: 900px;
        margin: 0 auto;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        padding: 20px;
        line-height: 1.6;
    }

    h2 {
        text-align: center;
        color: #2c3e50;
        margin-bottom: 30px;
    }

    .section {
        background-color: #fff;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

    h3 {
        margin-top: 0;
        margin-bottom: 15px;
        font-size: 1.5em;
        color: #34495e;
    }

    p {
        margin-bottom: 10px;
        font-size: 1.1em;
    }

    .text-area {
        width: 100%;
        height: 100px;
        padding: 10px;
        font-size: 1em;
        border: 1px solid #ccc;
        border-radius: 4px;
        resize: vertical;
    }

    .buttons {
        margin-top: 10px;
    }

    .btn {
        padding: 8px 16px;
        margin-right: 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1em;
        transition: background-color 0.3s;
    }

    .btn.edit {
        background-color: #3498db;
        color: #fff;
    }

    .btn.edit:hover {
        background-color: #2980b9;
    }

    .btn.save {
        background-color: #2ecc71;
        color: #fff;
    }

    .btn.save:hover {
        background-color: #27ae60;
    }

    .btn.cancel {
        background-color: #e74c3c;
        color: #fff;
    }

    .btn.cancel:hover {
        background-color: #c0392b;
    }

    /* Адаптивность на мобильных */
    media(max-width: 768px) {
        .about-section {
            padding: 10px;
        }

        h3 {
            font-size: 1.3em;
        }
    }
</style>